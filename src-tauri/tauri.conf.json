{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Recovery Manager",
  "version": "0.1.0",
  "identifier": "io.github.nonlog.codex-recovery-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Recovery Manager",
        "width": 870,
        "height": 720,
        "minWidth": 690,
        "minHeight": 610,
        "center": true,
        "backgroundColor": "#0f1115",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
